  "cards": [
    {
      "dot": "cyan",
      "title": "一个出口",
      "items": [
        "手机只认 /v1/messages（Anthropic 协议）",
        "OpenAI 兼容路径不开放，保持范围最小",
        "响应与流式内容原样回传，不二次加工"
      ]
    },
    {
      "dot": "emerald",
      "title": "不碰密钥",
      "items": [
        "网关只连本机 127.0.0.1:15721",
        "模型映射、账号分流、计费全部沿用 cc-switch",
        "RelayDesk 侧只保存一个访问令牌"
      ]
    },
    {
      "dot": "rose",
      "title": "失败可见",
      "items": [
        "令牌不符直接 401，不打到上游",
        "上游不可达返回 502 并记日志",
        "GUI 显示运行状态与当前连接数",
        "并发超过 4 个在途请求直接 429（不缓冲请求体）"
      ]
    }
