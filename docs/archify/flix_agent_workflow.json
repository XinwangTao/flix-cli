 ],
 "mainPath": ["poll", "guard", "cmd", "send", "cursor"],
 "nodes": [
  { "id": "poll", "lane": "agent", "col": 0, "type": "frontend",
    "label": "收件轮询", "sublabel": "bubbles since cursor", "width": 156 },
  { "id": "guard", "lane": "agent", "col": 1, "type": "security",
    "label": "护栏判定", "sublabel": "配对 / 前缀 / 限速 / 深度", "width": 168 },
  { "id": "cmd", "lane": "ai", "col": 2, "type": "external",
    "label": "--cmd 自定义命令", "sublabel": "stdin JSON → stdout 文本", "width": 176 },
  { "id": "send", "lane": "agent", "col": 3, "type": "backend",
    "label": "回发", "sublabel": "group send / send-text", "width": 158 },
  { "id": "cursor", "lane": "agent", "col": 4, "type": "backend",
    "label": "游标推进 + 日志", "sublabel": "agent.log / 去重", "width": 156 },
  { "id": "drop", "lane": "exceptions", "col": 1, "type": "security",
    "label": "丢弃", "sublabel": "未配对 / 自激 / 超频", "width": 150 },
  { "id": "fail", "lane": "exceptions", "col": 2, "type": "security",
    "label": "调用失败 / 超时", "sublabel": "记日志，不重发", "width": 156 },
  { "id": "human", "lane": "exceptions", "col": 4, "type": "external",
    "label": "人工介入", "sublabel": "读 agent.log 后手工回", "width": 158 }
 ],
 "edges": [
  { "from": "poll", "to": "guard", "label": "新气泡", "variant": "emphasis", "role": "main" },
  { "from": "guard", "to": "cmd", "label": "通过", "role": "main" },
  { "from": "guard", "to": "drop", "label": "未配对 / 带本机前缀 / 超频", "variant": "security", "role": "error" },
  { "from": "cmd", "to": "send", "label": "stdout 文本", "role": "main" },
  { "from": "cmd", "to": "fail", "label": "非零退出 / 超时", "variant": "security", "role": "error" },
  { "from": "fail", "to": "cursor", "label": "跳过并推进", "variant": "dashed" },
  { "from": "fail", "to": "human", "label": "告警", "variant": "dashed" },
  { "from": "send", "to": "cursor", "label": "已投递", "role": "main" }
 ],
 "cards": [
  { "dot": "cyan", "title": "输入契约（stdin JSON）",
    "items": [
      "from / alias / groupId / text / bubbleId / time",
      "环境变量：FLIX_SELF_FP、FLIX_SELF_ALIAS",
      "空 stdout = 不回；非零退出 = 失败不重发"
    ] },
  { "dot": "rose", "title": "护栏默认值（防自激）",
    "items": [
      "只回已配对（pair_devices）设备",
      "跳过本机前缀消息（默认 [A-AI]，可 --prefix 改）",
      "同一对端 ≥30s 才允许一次回复",
      "链式深度 ≥2 跳即停"
    ] },
  { "dot": "emerald", "title": "边界",
    "items": [
      "不做发现/配对，只消费 flixd 已收气泡",
      "不改线格式，不发新类型气泡",
      "无网络可达时退回记录，不阻塞 flixd"
    ] }
 ]
}
