  "changes": [
    {
      "node": "resolve",
      "level": "调整",
      "text": "APP_DIR 规范化：APPDATA 以 flixcli 结尾时回退父目录，杜绝 flixcli\\flixcli 这类嵌套状态目录。"
    },
    {
      "node": "load",
      "level": "调整",
      "text": "读取 prefs.identity 时校验 uuid 格式；缺失/损坏不再静默生成。"
    },
    {
      "node": "check",
      "level": "新增",
      "text": "新增有效性判定，只有缺失或损坏才进入迁移分支。"
    },
    {
      "node": "adopt",
      "level": "新增",
      "text": "扫描历史状态目录（%APPDATA%\\flixcli\\flixcli、~\\flixcli 等），沿用最近修改的 identity。"
    },
    {
      "node": "create",
      "level": "调整",
      "text": "仅当找不到任何旧身份才生成 uuid，并写 created_at，避免无痕迹换指纹。"
    },
    {
      "node": "persist",
      "level": "新增",
      "text": "写回规范位置并记录 adopted_from，`flix self --json` 可自查来源。"
    },
    {
      "node": "announce",
      "level": "调整",
      "text": "announce/ping_v2/配对一律使用同一稳定指纹，PC 在安卓列表只出现一行。"
    }
