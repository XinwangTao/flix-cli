{
  "_comment": "GitHub Bot 放行策略。改这个文件即改行为，不需要动 workflow。",
  "version": 2,
  "auto_approve": {
    "enabled": true,
    "authors": [
      "dependabot[bot]",
      "XinwangTao"
    ],
    "paths": [
      "**/*.md",
      "requirements*.txt",
      "poetry.lock",
      "uv.lock",
      "package-lock.json",
      "yarn.lock"
    ],
    "blocked_paths": [
      "tests/**",
      ".github/**",
      "src/**",
      "scripts/**",
      "pyproject.toml",
      "**/*.spec",
      "**/conftest.py",
      "tests/e2e.py"
    ],
    "max_files": 25,
    "max_additions": 600,
    "max_deletions": 300,
    "blocking_labels": [
      "needs-human"
    ],
    "auto_block_label": "gh-bot-needs-human",
    "ci_workflow_name": "CI"
  },
  "reply": {
    "model": "ccs-claude-openai--deepseek-v4.1-flash",
    "trusted_associations": [
      "OWNER",
      "MEMBER",
      "COLLABORATOR"
    ],
    "tools": "Read,Grep,Glob",
    "max_issue_body_chars": 8000,
    "max_comment_chars": 2000,
    "max_output_chars": 8000,
    "untrusted_disallowed": "Read,Write,Edit,MultiEdit,Bash,BashOutput,KillShell,Glob,Grep,LS,NotebookRead,NotebookEdit,WebFetch,WebSearch,Task,Skill,SlashCommand",
    "dangerous_tools": "Bash,Write,Edit,MultiEdit,WebFetch,WebSearch,Task,NotebookEdit",
    "max_runs_per_day": 120
  }
}
